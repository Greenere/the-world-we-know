{
  "name": "the-world-we-know",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A browser atlas of how much of the world each civilization knew, year by year.",
  "scripts": {
    "data": "uv run --project scripts python scripts/build_data.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/extensions": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/im-fell-english-sc": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/engine": "^9.4.2",
    "@luma.gl/shadertools": "^9.4.2",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^6.15.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
