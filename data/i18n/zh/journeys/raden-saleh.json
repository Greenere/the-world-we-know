   "note": "他乘船前往荷兰。"
  },
  "1": {
   "place": "海牙",
   "note": "随荷兰画家学画十年。"
  },
  "2": {
   "place": "德累斯顿",
   "note": "在萨克森宫廷与公爵、诗人为友。"
  },
  "3": {
   "place": "巴黎",
   "note": "他结识了奥拉斯·韦尔内。"
  },
  "4": {
