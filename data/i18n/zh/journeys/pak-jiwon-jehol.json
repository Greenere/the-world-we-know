{
 "name": "朴趾源热河之行",
 "traveler": "朴趾源",
 "years": "1780年",
 "summary": "一位无官职的学者随堂兄的使团去为乾隆皇帝祝七十大寿。皇帝已去了长城外的热河行宫，使臣只得追随前往。朴趾源在那里见到蒙古人和班禅喇嘛的西藏随从，他的《热河日记》主张朝鲜应向清朝学习实用之学。",
 "stops": {
  "0": {
   "place": "汉城",
   "note": "贺寿使团启程。"
  },
  "1": {
   "place": "义州",
   "note": "渡过涨水的鸭绿江。"
  },
  "2": {
   "place": "沈阳",
   "note": "清朝在满洲的旧都。"
  },
  "3": {
   "place": "山海关",
   "note": "穿过长城。"
  },
  "4": {
   "place": "北京",
   "note": "皇帝不在京城。"
  },
  "5": {
   "place": "热河",
   "note": "他在避暑山庄见到蒙古王公和班禅喇嘛的随从。"
  },
  "6": {
   "place": "汉城",
   "note": "秋天回国，写下《热河日记》。"
  }
 }
