  "grand-canal": {"style": "canal", "ended": "vanish", "phases": [
      {"id": "early", "name": "Early canals", "from": -486, "to": 605, "anchor": [119.45, 32.78], "note": "The king of Wu cuts the Hangou from the Yangtze to the Huai in 486 BCE; the Honggou soon links the Yellow River to the Huai's tributaries.", "paths": [[[119.42, 32.39], [119.45, 32.78], [119.15, 33.5]], [[113.38, 34.79], [114.3, 34.8], [114.88, 33.73], [115.6, 33.0], [116.5, 32.6]]]},
      {"id": "sui-tang", "name": "Sui and Tang", "from": 605, "to": 960, "anchor": [118.55, 33.0], "note": "Sui joins the old canals into one system in six years: the Tongji from Luoyang to the Huai, the Yongji north to Zhuojun, and the canal south to Hangzhou. Tang feeds its capitals with it.", "paths": [[[112.45, 34.62], [113.38, 34.79], [114.3, 34.8], [115.65, 34.42], [116.9, 33.9], [117.9, 33.48], [118.55, 33.0]], [[118.55, 33.0], [119.1, 33.4], [119.45, 32.78], [119.42, 32.39], [119.45, 32.2], [119.95, 31.78], [120.6, 31.3], [120.75, 30.75], [120.17, 30.27]], [[113.38, 34.79], [113.4, 35.1], [113.9, 35.3], [114.5, 35.9], [115.3, 36.5], [115.7, 36.84], [116.3, 37.45], [116.8, 38.3], [117.2, 39.1], [116.4, 39.9]]]},
      {"id": "song", "name": "Northern Song", "from": 960, "to": 1127, "anchor": [114.3, 34.8], "note": "The Bian canal brings the grain of the south to Kaifeng, the largest city in the world; the northern branch has silted up.", "paths": [[[112.45, 34.62], [113.38, 34.79], [114.3, 34.8], [115.65, 34.42], [116.9, 33.9], [117.9, 33.48], [118.55, 33.0]], [[118.55, 33.0], [119.1, 33.4], [119.45, 32.78], [119.42, 32.39], [119.45, 32.2], [119.95, 31.78], [120.6, 31.3], [120.75, 30.75], [120.17, 30.27]]]},
      {"id": "southern-song", "name": "Southern Song", "from": 1127, "to": 1293, "anchor": [120.75, 30.75], "note": "The Jin take the north and the Yellow River floods across the Bian; only the canal south of the Yangtze still serves, to the new capital at Hangzhou.", "paths": [[[119.45, 32.2], [119.95, 31.78], [120.6, 31.3], [120.75, 30.75], [120.17, 30.27]]]},
      {"id": "yuan", "name": "Yuan", "from": 1293, "to": 1368, "anchor": [116.6, 35.4], "note": "The Mongols cut a straight new course through Shandong to Dadu, the Beijing of today, bypassing Luoyang and Kaifeng; much grain still goes by sea.", "paths": [[[120.17, 30.27], [120.75, 30.75], [120.6, 31.3], [119.95, 31.78], [119.45, 32.2], [119.42, 32.39], [119.45, 32.78], [119.15, 33.5], [118.2, 34.0], [117.2, 34.26], [116.9, 34.9], [116.6, 35.4], [116.2, 36.0], [115.7, 36.84], [116.3, 37.45], [116.8, 38.3], [117.2, 39.1], [116.65, 39.9], [116.4, 39.9]]]},
      {"id": "ming-qing", "name": "Ming and Qing", "from": 1368, "to": 1855, "anchor": [116.4, 35.6], "note": "Ming reopens the canal in 1411 and from 1604 routes it clear of the Yellow River; for four centuries it carries the grain tribute to Beijing.", "paths": [[[120.17, 30.27], [120.75, 30.75], [120.6, 31.3], [119.95, 31.78], [119.45, 32.2], [119.42, 32.39], [119.45, 32.78], [119.15, 33.5], [118.3, 33.95], [117.95, 34.33], [117.73, 34.56], [117.2, 34.85], [116.6, 35.4], [116.2, 36.0], [115.7, 36.84], [116.3, 37.45], [116.8, 38.3], [117.2, 39.1], [116.65, 39.9], [116.4, 39.9]]]},
      {"id": "after-1855", "name": "After 1855", "from": 1855, "anchor": [119.0, 33.55], "note": "The Yellow River swings north and cuts the canal in Shandong; the grain goes by sea and rail, and only the southern reaches stay in use.", "paths": [[[120.17, 30.27], [120.75, 30.75], [120.6, 31.3], [119.95, 31.78], [119.45, 32.2], [119.42, 32.39], [119.45, 32.78], [119.15, 33.5], [118.3, 33.95], [117.95, 34.33], [117.73, 34.56], [117.2, 34.85], [116.6, 35.4]]]}
  ]},
