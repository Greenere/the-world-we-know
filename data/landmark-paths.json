{
  "great-wall": {"style": "wall", "phases": [
      {"id": "warring-states", "name": "Warring States walls", "from": -650, "to": -221, "anchor": [117.5, 36.3], "note": "Rival states wall themselves off from one another and from the steppe: Qi in Shandong, Zhao, Yan and Qin in the north.", "paths": [[[116.8, 36.4], [117.5, 36.3], [118.3, 36.0], [119.2, 36.0], [119.9, 35.95]], [[107.5, 41.0], [109.0, 40.7], [110.5, 40.8], [111.7, 40.9], [113.0, 40.9]], [[115.0, 41.3], [116.5, 41.6], [118.0, 41.8], [119.5, 42.0], [121.5, 42.2], [123.0, 41.8]], [[103.9, 35.4], [105.5, 35.8], [106.4, 36.6], [107.5, 37.5], [108.6, 38.4], [109.9, 39.3], [110.5, 39.9]]]},
      {"id": "qin", "name": "Qin", "from": -214, "to": -206, "anchor": [110.5, 40.8], "note": "The First Emperor joins the northern walls into one, from Lintao to Liaodong.", "paths": [[[103.9, 35.4], [104.6, 36.5], [105.6, 37.5], [106.4, 38.8], [106.9, 39.9], [107.5, 40.9], [109.0, 40.7], [110.5, 40.8], [111.7, 40.9], [113.0, 40.9], [115.0, 41.3], [116.5, 41.6], [118.0, 41.8], [119.5, 42.0], [121.5, 42.2], [123.0, 41.8], [124.3, 40.5]]]},
      {"id": "han", "name": "Han", "from": -127, "to": 220, "anchor": [93.86, 40.36], "note": "Han restores the Qin wall and carries it west along the Hexi Corridor to the Jade Gate, with beacons out toward Lop Nur, to guard the road to the West.", "paths": [[[103.9, 35.4], [104.6, 36.5], [105.6, 37.5], [106.4, 38.8], [106.9, 39.9], [107.5, 40.9], [109.0, 40.7], [110.5, 40.8], [111.7, 40.9], [113.0, 40.9], [115.0, 41.3], [116.5, 41.6], [118.0, 41.8], [119.5, 42.0], [121.5, 42.2], [123.0, 41.8], [124.3, 40.5]], [[103.8, 36.3], [102.6, 37.9], [101.4, 38.4], [100.4, 38.95], [99.0, 39.7], [98.2, 39.9], [97.0, 40.3], [95.8, 40.4], [94.7, 40.3], [93.86, 40.36], [93.0, 40.2], [91.5, 40.3]]]},
      {"id": "northern-qi-sui", "name": "Northern Qi and Sui", "from": 555, "to": 618, "anchor": [116.07, 40.29], "note": "Northern Qi raises a new line across Shanxi to the sea; Sui rebuilds it with forced labour.", "paths": [[[110.7, 39.0], [111.8, 39.6], [113.3, 40.2], [114.6, 40.5], [116.07, 40.29], [117.4, 40.4], [118.6, 40.2], [119.75, 40.0]]]},
      {"id": "tang", "name": "Tang", "from": 618, "to": 1123, "idle": true, "anchor": [93.86, 40.36], "note": "With its frontier far out on the steppe, Tang builds no wall; the old ones crumble."},
      {"id": "jin", "name": "Jin", "from": 1123, "to": 1215, "anchor": [115.5, 44.5], "note": "The Jurchen Jin dig border trenches behind ramparts far north across the Mongolian steppe; Genghis Khan's armies ride over them.", "paths": [[[123.5, 49.3], [122.0, 49.5], [119.5, 48.0], [117.5, 46.0], [115.5, 44.5], [113.5, 42.8], [111.5, 41.8], [110.0, 41.5]]]},
      {"id": "yuan", "name": "Yuan", "from": 1215, "to": 1368, "idle": true, "anchor": [116.07, 40.29], "note": "Inside the Mongol empire the wall guards nothing and is left to ruin; only the pass at Juyongguan is adorned, with the Cloud Platform of 1345."},
      {"id": "ming", "name": "Ming", "from": 1368, "to": 1644, "anchor": [119.79, 39.97], "note": "Ming rebuilds the wall from Shanhaiguan to Jiayuguan, faced in brick and stone after the 1570s: the wall seen today.", "paths": [[[119.79, 39.97], [119.2, 40.15], [118.3, 40.3], [117.45, 40.65], [116.55, 40.45], [116.02, 40.36], [115.4, 40.65], [114.85, 40.85], [114.0, 40.6], [113.3, 40.4], [112.4, 40.2], [111.5, 39.45], [110.9, 38.95], [109.7, 38.3], [108.9, 37.95], [107.6, 37.6], [106.6, 38.2], [106.0, 38.0], [105.2, 37.5], [104.3, 37.2], [103.3, 37.5], [102.6, 37.95], [101.4, 38.4], [100.4, 38.95], [99.5, 39.5], [98.21, 39.8]]]},
